{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ojimate-agent",
  "main": "index.js",
  "compatibility_date": "2026-09-22",
  "vars": {
    "PROVIDER": "workers-ai"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
